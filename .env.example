# Copy to .env. Keys live ONLY in the server .env, never in the repo or browser.
# Qloo: mock needs no key. live needs QLOO_API_KEY and refuses to start without it.
QLOO_MODE=mock
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# LLM: mock is a deterministic planner (no key). anthropic needs ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model is fixed to claude-haiku-5-5 in code; no other model is selectable.
# Hard stop for model spend in USD. Past it, runs use the planner.
LLM_SPEND_CAP_USD=4.00
# Random string used to hash IPs for rate limits. Raw IPs are never stored.
RATE_SALT=change-me
PORT=5117
DB_PATH=data/tribute.db

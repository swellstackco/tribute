{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "lib": ["ES2023", "DOM"],
    "types": ["node"], "noEmit": true, "allowImportingTsExtensions": false
  },
  "include": ["src", "scripts", "tests", "vite.config.ts"]
}
